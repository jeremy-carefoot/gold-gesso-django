{
  "version": 2,
  "engines": {
    "node": "22.x"
  },
  "builds": [
    {
      "src": "canvas_backend/wsgi.py",
      "use": "@vercel/python",
      "config": {
            "maxLambdaSize": "15mb",
            "runtime": "python3.12"
        }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "your_project/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    }
  ]
}